---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_META, SITE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const total = posts.length;
const year = new Date().getFullYear();
---

<BaseLayout>
  <section class="home-hero">
    <h1>{SITE.title}</h1>
    <p>
      {SITE.tagline} —— 一个安静的思考记录处。缠论复盘、读书笔记、偶尔随笔。
    </p>
    <p class="hero-meta">{year} · 共 {total} 篇 · 持续更新</p>
  </section>

  <nav class="category-filter" aria-label="分类筛选">
    <a class="filter-chip active" href="/">全部</a>
    {
      Object.entries(CATEGORY_META).map(([category, meta]) => (
        <a class="filter-chip" href={`/category/${meta.slug}`}>
          {category}
        </a>
      ))
    }
  </nav>

  <div class="editorial-list">
    {posts.map((post, i) => (
      <PostCard post={post} index={i} total={total} />
    ))}
  </div>
</BaseLayout>
