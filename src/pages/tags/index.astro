---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 聚合所有标签及文章数
const tagCount = new Map<string, number>();
for (const p of posts) {
  for (const t of p.data.tags) {
    tagCount.set(t, (tagCount.get(t) ?? 0) + 1);
  }
}
const tags = [...tagCount.entries()].sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh-Hans-CN')
);
---

<BaseLayout title="标签" description="全部文章标签索引">
  <header class="cat-header">
    <h1>标签</h1>
    <p>按主题归拢文章，共 {tags.length} 个标签。</p>
  </header>

  {
    tags.length > 0 ? (
      <ul class="tag-cloud">
        {
          tags.map(([tag, count]) => (
            <li>
              <a class="tag-chip" href={`/tags/${encodeURIComponent(tag)}/`}>
                {tag}
                <span class="tag-count">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    ) : (
      <p class="post-desc">还没有标签，写文章时在 frontmatter 的 tags 里加上即可。</p>
    )
  }
</BaseLayout>
