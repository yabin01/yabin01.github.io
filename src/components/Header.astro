---
import { SITE } from '../consts';

const nav = [
  { label: '首页', href: '/' },
  { label: '标签', href: '/tags' },
  { label: '书架', href: '/bookshelf' },
  { label: '归档', href: '/archive' },
  { label: '关于', href: '/about' },
];
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

// 站点 wordmark 的字符：取 ChingYuan 的特色字母 Y
const initial = 'Y';
---

<header class="site-nav">
  <div class="site-nav-inner">
    <a href="/" class="site-brand" aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark">{initial}</span>
      <span>{SITE.title}</span>
    </a>
    <nav class="site-nav-links" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[isActive(item.href) ? 'active' : '']}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a href="/search" class="nav-search" aria-label="搜索">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
    </a>
  </div>
</header>
