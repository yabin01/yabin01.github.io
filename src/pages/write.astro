---
import '../styles/global.css';
// 浏览器端写作台：填写表单 → 通过 GitHub Contents API 直接提交 .md → 触发 Pages 部署。
// 不在导航中公开，访问地址：/write
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>写作台 · ChingYuan'Blog</title>
  </head>
  <body>
    <header class="write-topbar">
      <div class="write-topbar-inner">
        <a href="/" class="write-back">← 返回博客</a>
        <span class="write-title-mini">写作台 · ChingYuan'Blog</span>
      </div>
    </header>

    <div class="write-wrap">
      <header class="write-head">
        <h1>写作台</h1>
        <p class="write-sub">在浏览器里写 Markdown，一键推送到 GitHub 并自动部署。</p>
      </header>

      <section class="card settings">
        <h2>GitHub 设置</h2>
        <div class="grid2">
          <label>
            个人访问令牌 (PAT)
            <input id="token" type="password" placeholder="ghp_xxx 或 github_pat_xxx" autocomplete="off" />
          </label>
          <label>
            仓库 (owner/repo)
            <input id="repo" type="text" value="yabin01/yabin01.github.io" />
          </label>
          <label>
            分支
            <input id="branch" type="text" value="main" />
          </label>
          <div class="save-row">
            <button id="saveSettings" class="btn">保存设置</button>
            <span class="hint">令牌仅存于本浏览器 localStorage，不会上传。</span>
          </div>
        </div>
        <p class="warn">
          令牌需具备该仓库的 <code>contents: write</code> 权限（建议用细粒度 PAT，仅授权此仓库）。
          公开站点上任何人都看得到这个页面，但没有你的令牌无法操作。
        </p>
      </section>

      <section class="card">
        <div class="toolbar">
          <select id="postList" aria-label="已有文章">
            <option value="">— 选择已有文章编辑 —</option>
          </select>
          <button id="refresh" class="btn ghost">刷新列表</button>
          <button id="new" class="btn ghost">新建</button>
        </div>
      </section>

      <div class="editor-grid">
        <section class="card">
          <h2>内容</h2>
          <div class="form">
            <label>
              文件标识 (slug，用于 URL，英文)
              <input id="slug" type="text" placeholder="如 chan-lun-zhongshu" />
            </label>
            <label>
              标题
              <input id="title" type="text" placeholder="文章标题" />
            </label>
            <div class="grid2">
              <label>
                分类
                <select id="category">
                  <option value="交易">交易</option>
                  <option value="读书">读书</option>
                  <option value="随笔">随笔</option>
                </select>
              </label>
              <label>
                日期
                <input id="pubDate" type="date" />
              </label>
            </div>
            <label>
              标签 (逗号分隔)
              <input id="tags" type="text" placeholder="缠论, 复盘" />
            </label>
            <label>
              摘要
              <input id="description" type="text" placeholder="一句话摘要" />
            </label>
            <label>
              封面图片 URL（可选）
              <input id="cover" type="text" placeholder="https://example.com/cover.jpg 或 /images/cover.jpg" />
            </label>
            <label class="check">
              <input id="draft" type="checkbox" /> 存为草稿（不发布）
            </label>
            <label>
              正文 (Markdown)
              <textarea id="body" rows="18" placeholder="在这里写正文…"></textarea>
            </label>

            <div class="uploader" id="dropZone">
              <div class="uploader-head">
                <span class="uploader-title">图片</span>
                <input id="imgDir" type="text" placeholder="子目录，留空则跟随文件标识" />
                <button id="pickImages" class="btn ghost" type="button">＋ 上传图片</button>
                <input id="fileInput" type="file" accept="image/*" multiple hidden />
              </div>
              <p class="hint">
                图片直接提交到仓库 <code>public/images/&lt;子目录&gt;/</code>，并在正文光标处自动插入引用。
                也可以拖拽到正文框，或截图后直接 <kbd>Ctrl</kbd>+<kbd>V</kbd> 粘贴。
              </p>
              <div id="uploadList" class="upload-list"></div>
            </div>

            <div class="actions">
              <button id="save" class="btn primary">保存并推送</button>
              <button id="delete" class="btn danger">删除此文</button>
            </div>
          </div>
        </section>

        <section class="card preview-card">
          <h2>预览</h2>
          <div id="preview" class="prose"></div>
        </section>
      </div>

      <div id="status" class="status" role="status"></div>
    </div>

    <style>
      /* —— 兼容新 token：把旧名桥接到 global.css 当前变量 —— */
      :root {
        --topbar-bg: var(--topbar);
        --topbar-muted: var(--topbar-text-muted);
        --topbar-height: var(--nav-h);
      }
      body {
        background: var(--canvas);
      }
      .write-topbar {
        position: sticky;
        top: 0;
        z-index: 100;
        background: var(--topbar-bg);
        color: #fff;
      }
      .write-topbar-inner {
        height: var(--topbar-height);
        display: flex;
        align-items: center;
        padding: 0 1.25rem;
        gap: 24px;
      }
      .write-back,
      .write-title-mini {
        color: #fff;
        font-size: 0.9rem;
        text-decoration: none;
      }
      .write-back {
        font-weight: 500;
        font-family: var(--font-nav);
      }
      .write-back:hover {
        opacity: 0.78;
      }
      .write-title-mini {
        color: var(--topbar-muted);
        margin: 0 auto;
      }
      .write-wrap {
        max-width: 70rem;
        margin: 0 auto;
        padding: 1.5rem 1.5rem 4rem;
      }
      .write-head h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0 0 0.25rem;
      }
      .write-sub {
        color: var(--text-muted);
        margin: 0 0 1.5rem;
        font-size: 0.9rem;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.3rem 1.4rem;
        margin-bottom: 1.2rem;
      }
      .card h2 {
        font-family: var(--font-serif);
        font-size: 1.15rem;
        margin: 0 0 1rem;
      }
      .grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }
      label {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.9rem;
      }
      label.check {
        flex-direction: row;
        align-items: center;
        gap: 0.5rem;
        color: var(--text);
      }
      /* 全局 input 是 width:100%，复选框要还原成自身宽度，否则把文字推到一边 */
      label.check input[type='checkbox'] {
        width: auto;
        margin: 0;
      }
      input,
      select,
      textarea {
        font: inherit;
        color: var(--text);
        background: var(--bg-subtle);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.55rem 0.7rem;
        width: 100%;
      }
      textarea {
        resize: vertical;
        line-height: 1.7;
        font-family: var(--font-mono);
        font-size: 0.9rem;
      }
      input:focus,
      select:focus,
      textarea:focus {
        outline: none;
        border-color: var(--accent-soft);
      }
      .btn {
        font: inherit;
        cursor: pointer;
        border: 1px solid var(--border);
        background: var(--surface);
        color: var(--text);
        border-radius: 8px;
        padding: 0.5rem 1rem;
        transition: all 0.15s ease;
      }
      .btn:hover {
        border-color: var(--accent-soft);
      }
      .btn.primary {
        background: var(--accent);
        border-color: var(--accent);
        color: #fff;
      }
      .btn.primary:hover {
        opacity: 0.92;
      }
      .btn.danger {
        color: #b4453a;
        border-color: #e7c4bf;
      }
      .btn.ghost {
        background: var(--bg-subtle);
      }
      .toolbar {
        display: flex;
        gap: 0.6rem;
        align-items: center;
      }
      .toolbar select {
        flex: 1;
      }
      .save-row {
        grid-column: 1 / -1;
        display: flex;
        align-items: center;
        gap: 0.8rem;
        flex-wrap: wrap;
      }
      .hint {
        font-size: 0.8rem;
        color: var(--text-muted);
      }
      .warn {
        font-size: 0.82rem;
        color: var(--text-muted);
        background: var(--bg-subtle);
        border-radius: 8px;
        padding: 0.7rem 0.9rem;
        margin: 0.5rem 0 0;
      }
      .warn code {
        font-family: var(--font-mono);
        background: var(--surface);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
      }
      .editor-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
        align-items: start;
      }
      .actions {
        display: flex;
        gap: 0.7rem;
        margin-top: 0.4rem;
      }
      /* —— 图片上传区 —— */
      .uploader {
        border: 1px dashed var(--border);
        border-radius: 10px;
        padding: 0.8rem 0.9rem;
        background: var(--bg-subtle);
        margin-bottom: 0.9rem;
        transition: border-color 0.15s ease, background 0.15s ease;
      }
      .uploader.dragover {
        border-color: var(--text);
        background: var(--surface);
      }
      .uploader-head {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }
      .uploader-title {
        font-size: 0.9rem;
        color: var(--text);
        font-weight: 500;
        flex-shrink: 0;
      }
      .uploader-head input[type='text'] {
        flex: 1;
        min-width: 10rem;
        padding: 0.4rem 0.6rem;
        font-size: 0.85rem;
      }
      .uploader .hint {
        margin: 0.6rem 0 0;
        line-height: 1.6;
      }
      .uploader .hint code,
      .uploader .hint kbd {
        font-family: var(--font-mono);
        font-size: 0.78rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 4px;
        padding: 0.05rem 0.3rem;
      }
      .upload-list {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-top: 0.6rem;
      }
      .upload-list:empty {
        margin-top: 0;
      }
      .upload-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: var(--text-muted);
      }
      .upload-item .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--border);
        flex-shrink: 0;
      }
      .upload-item.doing .dot {
        background: #c9a227;
      }
      .upload-item.done .dot {
        background: #2f6b43;
      }
      .upload-item.fail .dot {
        background: #b4453a;
      }
      .upload-item.fail {
        color: #b4453a;
      }
      .preview-card {
        position: sticky;
        top: 1rem;
      }
      .status {
        margin-top: 1rem;
        min-height: 1.4rem;
        font-size: 0.9rem;
        padding: 0.6rem 0.9rem;
        border-radius: 8px;
        display: none;
      }
      .status.show {
        display: block;
      }
      .status.ok {
        background: #eaf3ec;
        color: #2f6b43;
      }
      .status.err {
        background: #fbeceb;
        color: #b4453a;
      }
      [data-theme="dark"] .status.ok {
        background: #1a3a25;
        color: #7dca9e;
      }
      [data-theme="dark"] .status.err {
        background: #3a1f1c;
        color: #e8a097;
      }
      @media (max-width: 860px) {
        .editor-grid,
        .grid2 {
          grid-template-columns: 1fr;
        }
        .preview-card {
          position: static;
        }
      }
    </style>

    <script>
      import { marked } from 'marked';

      const $ = (id) => document.getElementById(id);
      const tokenEl = $('token'), repoEl = $('repo'), branchEl = $('branch');
      const slugEl = $('slug'), titleEl = $('title'), catEl = $('category');
      const dateEl = $('pubDate'), tagsEl = $('tags'), descEl = $('description');
      const coverEl = $('cover');
      const draftEl = $('draft'), bodyEl = $('body'), previewEl = $('preview');
      const postList = $('postList'), statusEl = $('status');

      let currentSha = null;
      let currentPath = null;

      const b64encode = (s) => btoa(unescape(encodeURIComponent(s)));
      const b64decode = (b) => decodeURIComponent(escape(atob(b)));

      function status(msg, type) {
        statusEl.textContent = msg;
        statusEl.className = 'status show ' + (type || '');
        if (type === 'ok') setTimeout(() => (statusEl.className = 'status'), 4000);
      }

      function api(path, opts = {}) {
        const headers = {
          Accept: 'application/vnd.github+json',
          Authorization: 'Bearer ' + tokenEl.value.trim(),
          'X-GitHub-Api-Version': '2022-11-28',
        };
        if (opts.body) headers['Content-Type'] = 'application/json';
        return fetch('https://api.github.com' + path, { ...opts, headers });
      }

      function renderPreview() {
        previewEl.innerHTML = marked.parse(bodyEl.value || '_（预览区）_');
      }

      function parseFrontmatter(raw) {
        const m = raw.match(/^---\s*\n([\s\S]*?)\n---\s*\n?([\s\S]*)$/);
        if (!m) return { data: {}, body: raw };
        const fm = m[1], body = m[2];
        const data = {};
        fm.split('\n').forEach((line) => {
          const i = line.indexOf(':');
          if (i === -1) return;
          const key = line.slice(0, i).trim();
          let val = line.slice(i + 1).trim().replace(/^["']|["']$/g, '');
          if (key === 'tags') {
            try {
              data.tags = JSON.parse(val.replace(/'/g, '"'));
            } catch {
              data.tags = val
                .replace(/^\[|\]$/g, '')
                .split(',')
                .map((s) => s.trim().replace(/^["']|["']$/g, ''))
                .filter(Boolean);
            }
          } else if (key === 'draft') {
            data.draft = val === 'true';
          } else {
            data[key] = val;
          }
        });
        return { data, body };
      }

      function buildMarkdown() {
        const slug = (slugEl.value.trim() || 'post-' + Date.now()).replace(/\s+/g, '-');
        const title = titleEl.value.trim() || '未命名';
        const category = catEl.value;
        const tags = tagsEl.value.split(',').map((s) => s.trim()).filter(Boolean);
        const pubDate = dateEl.value || new Date().toISOString().slice(0, 10);
        const description = descEl.value.trim();
        const draft = draftEl.checked;
        const cover = coverEl.value.trim();
        const tagsStr = '[' + tags.map((t) => `"${t}"`).join(', ') + ']';
        const fm = [
          '---',
          `title: ${title}`,
          ...(description ? [`description: ${description}`] : []),
          `pubDate: ${pubDate}`,
          `category: ${category}`,
          `tags: ${tagsStr}`,
          ...(cover ? [`cover: ${cover}`] : []),
          `draft: ${draft}`,
          '---',
          '',
        ].join('\n');
        return { slug, content: fm + bodyEl.value + '\n' };
      }

      function resetForm() {
        slugEl.value = titleEl.value = tagsEl.value = descEl.value = coverEl.value = bodyEl.value = '';
        catEl.value = '交易';
        draftEl.checked = false;
        dateEl.value = new Date().toISOString().slice(0, 10);
        currentSha = null;
        currentPath = null;
        renderPreview();
      }

      async function loadPosts() {
        if (!tokenEl.value.trim()) return;
        try {
          const res = await api(`/repos/${repoEl.value.trim()}/contents/src/content/posts`);
          if (!res.ok) return;
          const files = await res.json();
          const mds = files.filter((f) => f.name.endsWith('.md'));
          postList.innerHTML =
            '<option value="">— 选择已有文章编辑 —</option>' +
            mds
              .map((f) => `<option value="${f.path}" data-sha="${f.sha}">${f.name}</option>`)
              .join('');
        } catch (e) {
          /* ignore */
        }
      }

      async function loadPost(path, sha) {
        const res = await api(`/repos/${repoEl.value.trim()}/contents/${path}`);
        const d = await res.json();
        const text = b64decode(d.content);
        const { data, body } = parseFrontmatter(text);
        titleEl.value = data.title || '';
        catEl.value = data.category || '交易';
        tagsEl.value = (data.tags || []).join(', ');
        dateEl.value = (data.pubDate || '').slice(0, 10);
        descEl.value = data.description || '';
        coverEl.value = data.cover || '';
        draftEl.checked = !!data.draft;
        bodyEl.value = body;
        slugEl.value = path.split('/').pop().replace(/\.md$/, '');
        currentSha = d.sha;
        currentPath = path;
        renderPreview();
        status('已载入：' + path, 'ok');
      }

      async function save() {
        if (!tokenEl.value.trim()) return status('请先填写并保存 GitHub Token', 'err');
        const { slug, content } = buildMarkdown();
        const path = `src/content/posts/${slug}.md`;
        const body = {
          message: `blog: ${slug}`,
          content: b64encode(content),
          branch: branchEl.value.trim() || 'main',
        };
        if (currentSha) body.sha = currentSha;
        status('推送中…');
        const res = await api(`/repos/${repoEl.value.trim()}/contents/${path}`, {
          method: 'PUT',
          body: JSON.stringify(body),
        });
        if (res.ok) {
          const j = await res.json();
          currentSha = j.content.sha;
          currentPath = path;
          status('已推送 ✓ GitHub Actions 将自动部署', 'ok');
          await loadPosts();
        } else {
          const e = await res.json().catch(() => ({}));
          status('推送失败：' + (e.message || res.status), 'err');
        }
      }

      async function del() {
        if (!tokenEl.value.trim()) return status('请先填写并保存 GitHub Token', 'err');
        if (!currentPath || !currentSha) return status('没有可删除的文章（请先在列表选择要删除的文章）', 'err');
        if (!confirm('确定删除该文章？此操作不可撤销。')) return;
        status('删除中…');
        const res = await api(`/repos/${repoEl.value.trim()}/contents/${currentPath}`, {
          method: 'DELETE',
          body: JSON.stringify({
            message: 'delete ' + currentPath,
            sha: currentSha,
            branch: branchEl.value.trim() || 'main',
          }),
        });
        if (res.ok) {
          status('已删除 ✓ GitHub Actions 将自动部署', 'ok');
          resetForm();
          await loadPosts();
        } else {
          const e = await res.json().catch(() => ({}));
          let msg = e.message || `HTTP ${res.status}`;
          if (res.status === 404) msg = '令牌权限不足（需 contents 写权限）或文章不存在：' + msg;
          if (res.status === 409) msg = '文章内容已变动，请刷新列表后重新选择再删：' + msg;
          if (res.status === 401) msg = '令牌无效或已过期：' + msg;
          status('删除失败：' + msg, 'err');
        }
      }

      // —— 图片上传 ——
      const imgDirEl = $('imgDir');
      const fileInput = $('fileInput');
      const dropZone = $('dropZone');
      const uploadList = $('uploadList');

      // 规范文件名：空格转连字符，去掉 URL/Markdown 里的危险字符，保留扩展名
      function sanitizeName(name) {
        const raw = String(name || '').trim();
        const m = raw.match(/^(.*?)(\.[A-Za-z0-9]{1,8})$/);
        const base = m ? m[1] : raw;
        const ext = m ? m[2].toLowerCase() : '.png';
        const safe = base
          .replace(/\s+/g, '-')
          .replace(/[^\w\u4e00-\u9fa5-]/g, '-')
          .replace(/-+/g, '-')
          .replace(/^-|-$/g, '');
        return (safe || 'image') + ext;
      }

      const encodePath = (p) => p.split('/').map(encodeURIComponent).join('/');

      function readAsBase64(file) {
        return new Promise((resolve, reject) => {
          const r = new FileReader();
          r.onload = () => resolve(String(r.result).split(',')[1] || '');
          r.onerror = () => reject(new Error('读取文件失败'));
          r.readAsDataURL(file);
        });
      }

      function addUploadRow(name, tip) {
        const row = document.createElement('div');
        row.className = 'upload-item doing';
        const dot = document.createElement('span');
        dot.className = 'dot';
        const txt = document.createElement('span');
        txt.className = 'txt';
        txt.textContent = `${name} · ${tip}`;
        row.append(dot, txt);
        uploadList.appendChild(row);
        const set = (cls, msg) => {
          row.className = 'upload-item ' + cls;
          txt.textContent = msg;
        };
        return {
          done: (msg) => set('done', msg),
          fail: (msg) => set('fail', msg),
        };
      }

      // 插到正文光标处；批量时全部拼在一起插一次
      function insertAtCursor(text) {
        const v = bodyEl.value;
        const s = typeof bodyEl.selectionStart === 'number' ? bodyEl.selectionStart : v.length;
        const e = typeof bodyEl.selectionEnd === 'number' ? bodyEl.selectionEnd : v.length;
        const before = v.slice(0, s);
        const after = v.slice(e);
        const lead = before && !before.endsWith('\n') ? '\n\n' : '';
        const chunk = lead + text + '\n';
        bodyEl.value = before + chunk + after;
        const pos = (before + chunk).length;
        bodyEl.setSelectionRange(pos, pos);
        bodyEl.focus();
        renderPreview();
      }

      async function uploadImages(fileList) {
        const files = [...(fileList || [])].filter((f) => f && /^image\//i.test(f.type || ''));
        if (!files.length) return;
        if (!tokenEl.value.trim()) return status('请先填写并保存 GitHub Token，再上传图片', 'err');
        const repo = repoEl.value.trim();
        const branch = branchEl.value.trim() || 'main';
        const dir = (imgDirEl.value.trim() || slugEl.value.trim() || 'misc').replace(/^\/+|\/+$/g, '');
        const used = new Set();
        const marks = [];
        let okCount = 0;

        for (const file of files) {
          let fname = sanitizeName(file.name);
          // 同一批里重名的自动加序号，避免后一张把前一张覆盖掉
          if (used.has(fname)) {
            const m = fname.match(/^(.*?)(\.[A-Za-z0-9]{1,8})$/);
            let i = 2;
            let cand = fname;
            do {
              cand = m ? `${m[1]}-${i}${m[2]}` : `${fname}-${i}`;
              i++;
            } while (used.has(cand));
            fname = cand;
          }
          used.add(fname);

          const path = `public/images/${dir}/${fname}`;
          const row = addUploadRow(fname, '上传中…');
          try {
            const b64 = await readAsBase64(file);
            // 远端已存在同名文件时要带上 sha 才能更新
            let sha = null;
            const head = await api(`/repos/${repo}/contents/${encodePath(path)}?ref=${encodeURIComponent(branch)}`);
            if (head.ok) {
              const j = await head.json();
              sha = j.sha;
            }
            const putBody = {
              message: `blog: 上传图片 ${dir}/${fname}`,
              content: b64,
              branch,
              ...(sha ? { sha } : {}),
            };
            const res = await api(`/repos/${repo}/contents/${encodePath(path)}`, {
              method: 'PUT',
              body: JSON.stringify(putBody),
            });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.message || `HTTP ${res.status}`);
            }
            marks.push(`![${fname}](/images/${dir}/${fname})`);
            okCount++;
            row.done(`${fname} · 已上传${sha ? '（覆盖同名）' : ''}`);
          } catch (err) {
            row.fail(`${fname} · 失败：${err.message}`);
          }
        }

        if (marks.length) {
          insertAtCursor(marks.join('\n\n'));
          status(`已上传 ${okCount}/${files.length} 张图片，引用已插入正文光标处 ✓ 记得点「保存并推送」`, 'ok');
        } else {
          status('图片上传失败，请检查令牌是否有该仓库的 contents 写权限', 'err');
        }
      }

      // 事件
      bodyEl.addEventListener('input', renderPreview);
      $('pickImages').addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', () => {
        uploadImages(fileInput.files);
        fileInput.value = '';
      });
      // 截图后直接 Ctrl+V 粘贴到正文框
      bodyEl.addEventListener('paste', (ev) => {
        const fs = ev.clipboardData && ev.clipboardData.files;
        if (fs && fs.length) {
          ev.preventDefault();
          uploadImages(fs);
        }
      });
      // 拖拽到上传区或正文框
      ['dragenter', 'dragover'].forEach((t) =>
        dropZone.addEventListener(t, (ev) => {
          ev.preventDefault();
          dropZone.classList.add('dragover');
        })
      );
      ['dragleave', 'drop'].forEach((t) =>
        dropZone.addEventListener(t, (ev) => {
          ev.preventDefault();
          dropZone.classList.remove('dragover');
        })
      );
      dropZone.addEventListener('drop', (ev) => {
        if (ev.dataTransfer && ev.dataTransfer.files.length) uploadImages(ev.dataTransfer.files);
      });
      bodyEl.addEventListener('dragover', (ev) => ev.preventDefault());
      bodyEl.addEventListener('drop', (ev) => {
        if (ev.dataTransfer && ev.dataTransfer.files.length) {
          ev.preventDefault();
          uploadImages(ev.dataTransfer.files);
        }
      });
      $('saveSettings').addEventListener('click', () => {
        localStorage.setItem('gh_token', tokenEl.value.trim());
        localStorage.setItem('gh_repo', repoEl.value.trim());
        localStorage.setItem('gh_branch', branchEl.value.trim());
        status('设置已保存到本浏览器', 'ok');
        loadPosts();
      });
      $('refresh').addEventListener('click', loadPosts);
      $('new').addEventListener('click', () => {
        resetForm();
        postList.value = '';
        status('已清空，开始新文章', 'ok');
      });
      $('save').addEventListener('click', save);
      $('delete').addEventListener('click', del);
      postList.addEventListener('change', () => {
        const opt = postList.selectedOptions[0];
        if (opt && opt.value) loadPost(opt.value, opt.dataset.sha);
      });

      // 初始化
      tokenEl.value = localStorage.getItem('gh_token') || '';
      repoEl.value = localStorage.getItem('gh_repo') || 'yabin01/yabin01.github.io';
      branchEl.value = localStorage.getItem('gh_branch') || 'main';
      dateEl.value = new Date().toISOString().slice(0, 10);
      renderPreview();
      if (tokenEl.value.trim()) loadPosts();

    </script>
  </body>
</html>
