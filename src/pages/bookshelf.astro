---
import BaseLayout from '../layouts/BaseLayout.astro';
import bookshelf from '../data/weread.json';

const { stats, books, updated } = bookshelf;

function fmtDate(ts?: number) {
  if (!ts) return '';
  const d = new Date(ts * 1000);
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

function fmtHours(min?: number) {
  if (!min) return '0';
  return (min / 60).toFixed(min < 600 ? 1 : 0);
}

const statItems = [
  { label: '书架藏书', value: String(stats.totalBooks) },
  { label: '读完', value: String(stats.finishedBooks) },
  { label: '划线', value: String(stats.highlights) },
  { label: '想法', value: String(stats.thoughts) },
  { label: '阅读时长', value: `${fmtHours(stats.readMinutes)} 小时` },
  { label: '阅读天数', value: String(stats.readDays) },
];

// 按年阅读时长 → 柱状图数据
const yearly: { year: number; hours: number }[] = Object.entries(stats.yearlyReadTimes || {})
  .map(([ts, sec]) => ({
    year: new Date(Number(ts) * 1000).getFullYear(),
    hours: Math.round(Number(sec) / 3600),
  }))
  .filter((x) => x.year > 2010)
  .sort((a, b) => a.year - b.year);
const maxYearHours = Math.max(1, ...yearly.map((y) => y.hours));
const totalYearHours = yearly.reduce((s, y) => s + y.hours, 0);

// 当月每日阅读时长 → 柱状图数据（key=当天 0 点时间戳，value=秒）
const daily: { ts: number; label: string; minutes: number }[] = Object.entries(stats.dailyReadTimes || {})
  .map(([ts, sec]) => {
    const d = new Date(Number(ts) * 1000);
    return {
      ts: Number(ts),
      label: `${d.getMonth() + 1}/${d.getDate()}`,
      minutes: Math.round(Number(sec) / 60),
    };
  })
  .sort((a, b) => a.ts - b.ts);
const maxDailyMinutes = Math.max(1, ...daily.map((x) => x.minutes));
const totalDailyMinutes = daily.reduce((s, x) => s + x.minutes, 0);
const dailyMonthLabel = daily.length > 0 ? `${new Date(daily[0].ts * 1000).getFullYear()} 年 ${new Date(daily[0].ts * 1000).getMonth() + 1} 月` : '';

// 划线按章节分组
function groupHighlights(highlights: { chapter: string; text: string; createTime: number }[]) {
  const map = new Map<string, typeof highlights>();
  for (const h of highlights) {
    const k = h.chapter || '未分章节';
    if (!map.has(k)) map.set(k, []);
    map.get(k)!.push(h);
  }
  return Array.from(map.entries()).map(([chapter, items]) => ({ chapter, items }));
}

const booksProcessed = books.map((b) => ({
  ...b,
  highlightGroups: b.highlights.length ? groupHighlights(b.highlights) : [],
}));
---

<BaseLayout title="我的书架" description="清远先生的微信读书书架、划线与想法">
  <div class="bookshelf">
    <header class="page-head">
      <div class="page-head-row">
        <h1>我的书架</h1>
        <button id="sync-btn" class="shelf-sync-btn" type="button" title="从微信读书同步最新划线与想法">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 2v6h-6"></path>
            <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
            <path d="M3 22v-6h6"></path>
            <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
          </svg>
          同步书架
        </button>
      </div>
      <p class="page-sub">
        微信读书同步 · 划线与想法
        {updated && <span class="shelf-updated">更新于 {updated}</span>}
        <span id="sync-status" class="sync-status" role="status"></span>
      </p>
    </header>

    {
      stats.totalBooks === 0 ? (
        <div class="shelf-empty">
          <p>书架数据尚未同步。</p>
          <p class="hint">等待导入微信读书的划线与想法数据。</p>
        </div>
      ) : (
        <>
          <div class="shelf-stats">
            {statItems.map((s) => (
              <div class="stat-item">
                <span class="stat-value">{s.value}</span>
                <span class="stat-label">{s.label}</span>
              </div>
            ))}
          </div>

          {yearly.length > 0 && (
            <section class="chart-card">
              <div class="chart-head">
                <h3>每年阅读时长</h3>
                <span class="chart-meta">共 {totalYearHours} 小时</span>
              </div>
              <div class="year-chart">
                {yearly.map((y) => (
                  <div class="year-col" title={`${y.year} 年：${y.hours} 小时`}>
                    <div class="year-bar" style={`height: ${(y.hours / maxYearHours) * 100}%`}>
                      <span class="bar-val">{y.hours}</span>
                    </div>
                    <span class="bar-year">{y.year}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          {daily.length > 0 && (
            <section class="chart-card">
              <div class="chart-head">
                <h3>{dailyMonthLabel} · 每日阅读时长</h3>
                <span class="chart-meta">共 {totalDailyMinutes} 分钟 · {daily.length} 天</span>
              </div>
              <div class="year-chart daily-chart">
                {daily.map((d) => (
                  <div class="year-col" title={`${d.label}：${d.minutes} 分钟`}>
                    <div class="year-bar" style={`height: ${(d.minutes / maxDailyMinutes) * 100}%`}>
                      <span class="bar-val">{d.minutes >= 60 ? `${(d.minutes / 60).toFixed(1)}h` : `${d.minutes}m`}</span>
                    </div>
                    <span class="bar-year">{d.label}</span>
                  </div>
                ))}
              </div>
            </section>
          )}

          <div class="shelf-books">
            {booksProcessed.map((b, i) => (
              <details class="book-card" open={i === 0}>
                <summary>
                  <span class="book-cover">
                    {b.cover ? <img src={b.cover} alt={b.title} loading="lazy" /> : <span class="cover-fallback">{b.title.slice(0, 1)}</span>}
                  </span>
                  <span class="book-meta">
                    <span class="book-title">{b.title}</span>
                    <span class="book-author">{b.author}</span>
                    <span class="book-tags">
                      {b.finished ? <span class="tag-done">读完</span> : <span class="tag-reading">在读 {b.progress ? `${b.progress}%` : ''}</span>}
                      <span class="tag-count">{b.highlightCount} 条划线</span>
                      {b.thoughtCount > 0 && <span class="tag-count">{b.thoughtCount} 条想法</span>}
                    </span>
                  </span>
                  <span class="book-extra">
                    {b.lastReadAt > 0 && <span class="book-lastread">最近 {fmtDate(b.lastReadAt)}</span>}
                    <span class="book-toggle" aria-hidden="true"></span>
                  </span>
                </summary>

                <div class="book-body">
                  <div class="note-tabs" role="tablist">
                    <button class="note-tab active" type="button" data-tab="hl" role="tab" aria-selected="true">
                      划线 <span class="tab-count">{b.highlightCount}</span>
                    </button>
                    <button class="note-tab" type="button" data-tab="th" role="tab" aria-selected="false" disabled={b.thoughtCount === 0}>
                      想法 <span class="tab-count">{b.thoughtCount}</span>
                    </button>
                  </div>

                  <div class="note-panel hl-panel active" role="tabpanel">
                    {b.highlightGroups.length > 0 ? (
                      <div class="hl-chapters">
                        {b.highlightGroups.map((g) => (
                          <details class="hl-chapter">
                            <summary>
                              <span class="hl-chapter-title">{g.chapter}</span>
                              <span class="hl-chapter-count">{g.items.length}</span>
                            </summary>
                            <ul class="hl-list">
                              {g.items.map((h) => (
                                <li>
                                  <blockquote>{h.text}</blockquote>
                                </li>
                              ))}
                            </ul>
                          </details>
                        ))}
                      </div>
                    ) : (
                      <p class="note-none">暂无划线</p>
                    )}
                  </div>

                  <div class="note-panel th-panel" role="tabpanel" hidden>
                    {b.thoughts.length > 0 ? (
                      <ul class="th-list">
                        {b.thoughts.map((t) => (
                          <li>
                            {t.abstract && <blockquote class="th-abstract">{t.abstract}</blockquote>}
                            <p class="th-content">{t.content}</p>
                            {t.createTime && <span class="note-date">{fmtDate(t.createTime)}</span>}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="note-none">暂无想法</p>
                    )}
                  </div>
                </div>
              </details>
            ))}
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<script>
  // Tab 切换
  document.querySelectorAll('.note-tabs').forEach((tabs) => {
    const card = tabs.closest('.book-card');
    if (!card) return;
    const buttons = tabs.querySelectorAll<HTMLButtonElement>('.note-tab');
    const hlPanel = card.querySelector<HTMLElement>('.hl-panel');
    const thPanel = card.querySelector<HTMLElement>('.th-panel');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        const tab = btn.dataset.tab;
        buttons.forEach((b) => {
          const isActive = b === btn;
          b.classList.toggle('active', isActive);
          b.setAttribute('aria-selected', String(isActive));
        });
        hlPanel?.classList.toggle('active', tab === 'hl');
        thPanel?.classList.toggle('active', tab === 'th');
        if (hlPanel) hlPanel.hidden = tab !== 'hl';
        if (thPanel) thPanel.hidden = tab !== 'th';
      });
    });
  });

  // 同步按钮
  const syncBtn = document.getElementById('sync-btn');
  const syncStatus = document.getElementById('sync-status');
  const REPO_KEY = 'gh_repo';
  const TOKEN_KEY = 'gh_token';

  function setStatus(msg: string, ok?: boolean) {
    if (!syncStatus) return;
    syncStatus.textContent = msg;
    (syncStatus as HTMLElement).style.color = ok ? 'var(--accent)' : '#b4453a';
  }

  syncBtn?.addEventListener('click', async () => {
    let token = localStorage.getItem(TOKEN_KEY);
    const repo = localStorage.getItem(REPO_KEY) || 'yabin01/yabin01.github.io';

    if (!token) {
      token = prompt('首次同步需填写 GitHub 访问令牌（需 workflow 权限，仅存于本浏览器）:\n\n（可去 /write 页面保存，两者共用同一令牌）');
      if (!token) return;
      localStorage.setItem(TOKEN_KEY, token.trim());
      localStorage.setItem(REPO_KEY, repo);
    }

    syncBtn.disabled = true;
    syncBtn.classList.add('loading');
    setStatus('正在触发同步…');

    try {
      const res = await fetch(`https://api.github.com/repos/${repo}/actions/workflows/sync-weread.yml/dispatches`, {
        method: 'POST',
        headers: {
          Accept: 'application/vnd.github+json',
          Authorization: 'Bearer ' + token.trim(),
          'X-GitHub-Api-Version': '2022-11-28',
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ ref: 'main' }),
      });

      if (res.status === 204) {
        setStatus('✓ 同步已触发，约 1~2 分钟后自动部署生效，届时刷新页面即可看到最新数据', true);
      } else if (res.status === 401) {
        localStorage.removeItem(TOKEN_KEY);
        setStatus('令牌无效，请重新点击并输入正确的令牌');
      } else if (res.status === 403 || res.status === 404) {
        setStatus('令牌权限不足（需 workflow 权限）或 workflow 未部署，请检查令牌后重试');
      } else {
        const e = await res.json().catch(() => ({}));
        setStatus('触发失败：' + (e.message || res.status));
      }
    } catch (err: any) {
      setStatus('网络错误：' + err.message);
    } finally {
      syncBtn.disabled = false;
      syncBtn.classList.remove('loading');
    }
  });
</script>