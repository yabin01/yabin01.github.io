---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Comments from '../../components/Comments.astro';
import { getCollection, render } from 'astro:content';
import { CATEGORY_META } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const meta = CATEGORY_META[post.data.category];

// 按发布时间倒序找到当前文章，得出相邻的新/旧文章
const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const idx = allPosts.findIndex((p) => p.id === post.id);
const newerPost = idx > 0 ? allPosts[idx - 1] : null;
const olderPost = idx >= 0 && idx < allPosts.length - 1 ? allPosts[idx + 1] : null;
---

<BaseLayout title={post.data.title} description={post.data.description} noAside>
  <article class="post-article">
    <header class="post-header">
      <div class="post-meta">
        <a class="post-cat" href={`/category/${meta.slug}`}>{post.data.category}</a>
        <FormattedDate date={post.data.pubDate} />
        {
          post.data.updatedDate && (
            <span class="updated">
              · 更新于 <FormattedDate date={post.data.updatedDate} />
            </span>
          )
        }
      </div>
      <h1 class="post-h1">{post.data.title}</h1>
      {post.data.description && <p class="post-lead">{post.data.description}</p>}
      {post.data.cover && (
        <div class="post-cover">
          <img src={post.data.cover} alt={post.data.title} />
        </div>
      )}
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <ul class="post-tags">
          {post.data.tags.map((t) => (
            <li>
              <a href={`/tags/${encodeURIComponent(t)}/`}>{t}</a>
            </li>
          ))}
        </ul>
      )
    }

    <nav class="post-nav" aria-label="相邻文章">
      {
        olderPost ? (
          <a class="post-nav-item post-nav-prev" href={`/posts/${olderPost.id}/`}>
            <span class="post-nav-label">← 上一篇文章</span>
            <span class="post-nav-title">{olderPost.data.title}</span>
          </a>
        ) : (
          <span class="post-nav-item is-empty" aria-hidden="true" />
        )
      }
      {
        newerPost ? (
          <a class="post-nav-item post-nav-next" href={`/posts/${newerPost.id}/`}>
            <span class="post-nav-label">下一篇文章 →</span>
            <span class="post-nav-title">{newerPost.data.title}</span>
          </a>
        ) : (
          <span class="post-nav-item is-empty" aria-hidden="true" />
        )
      }
    </nav>

    <Comments />
  </article>
</BaseLayout>
