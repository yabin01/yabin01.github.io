---
import FormattedDate from './FormattedDate.astro';
import { CATEGORY_META } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
  total?: number;
}
const { post, index, total } = Astro.props;
const meta = CATEGORY_META[post.data.category];

// 编辑级编号：按总篇数动态补零（8 篇 → 1~8；100 篇 → 001~100）
const pad = typeof total === 'number' ? String(total).length : 0;
const num =
  typeof index === 'number'
    ? String(index + 1).padStart(pad, '0')
    : '';
---

<article class="editorial-item">
  <div class="editorial-num" aria-hidden="true">{num}</div>
  <div class="editorial-body">
    <h3 class="editorial-title">
      <a href={`/posts/${post.id}/`}>{post.data.title}</a>
    </h3>
    {
      post.data.description && (
        <p class="editorial-desc">{post.data.description}</p>
      )
    }
  </div>
  <div class="editorial-meta">
    <FormattedDate date={post.data.pubDate} />
  </div>
  <a class="editorial-cat" href={`/category/${meta.slug}`}>
    {post.data.category}
  </a>
</article>
